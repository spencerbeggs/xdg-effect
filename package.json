{
	"name": "xdg-effect",
	"version": "1.0.2",
	"private": true,
	"description": "Opinionated Effect library for XDG Base Directory support — composable layers from path resolution through config management to SQLite-backed caching and state.",
	"keywords": [
		"effect",
		"xdg",
		"xdg-base-directory",
		"config",
		"configuration",
		"toml",
		"cli",
		"sqlite",
		"cache",
		"layer",
		"dependency-injection",
		"typescript"
	],
	"homepage": "https://github.com/spencerbeggs/xdg-effect#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/xdg-effect/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/xdg-effect.git"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"build": "turbo run build:dev build:prod --log-order=grouped --log-prefix=none",
		"build:dev": "node savvy.build.ts --target dev",
		"build:meta": "node savvy.build.ts --target meta",
		"build:prod": "node savvy.build.ts --target prod",
		"ci:build": "CI=\"true\" turbo run build:dev build:prod --log-order=grouped --output-logs=full --log-prefix=none",
		"ci:test": "CI=\"true\" vitest run --passWithNoTests",
		"ci:version": "savvy changeset version && biome format --write .",
		"lint": "biome check --max-diagnostics=none",
		"lint:fix": "biome check --write --max-diagnostics=none",
		"lint:fix:unsafe": "biome check --write --unsafe --max-diagnostics=none",
		"lint:md": "markdownlint-cli2 --config './lib/configs/.markdownlint-cli2.jsonc'",
		"lint:md:fix": "markdownlint-cli2 --config './lib/configs/.markdownlint-cli2.jsonc' --fix",
		"prepare": "husky",
		"test": "vitest run --passWithNoTests",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest --watch",
		"typecheck": "turbo run types:check --log-prefix=none --log-order=grouped",
		"types:check": "tsgo --noEmit"
	},
	"dependencies": {
		"config-file-effect": "^0.2.2",
		"json-schema-effect": "^0.2.4"
	},
	"devDependencies": {
		"@effect/platform": "catalog:silk",
		"@effect/platform-node": "catalog:silk",
		"@effect/sql": "catalog:silk",
		"@effect/sql-sqlite-node": "catalog:silk",
		"@savvy-web/bundler": "^0.5.0",
		"@savvy-web/silk": "^1.1.0",
		"@savvy-web/vitest": "^1.5.1",
		"ajv": "^8.20.0",
		"effect": "catalog:silkPeers"
	},
	"peerDependencies": {
		"@effect/platform": "catalog:silkPeers",
		"@effect/platform-node": "catalog:silkPeers",
		"@effect/sql": "catalog:silkPeers",
		"@effect/sql-sqlite-node": "catalog:silkPeers",
		"ajv": "^8.20.0",
		"effect": "catalog:silkPeers"
	},
	"peerDependenciesMeta": {
		"@effect/platform-node": {
			"optional": true
		},
		"@effect/sql": {
			"optional": true
		},
		"@effect/sql-sqlite-node": {
			"optional": true
		},
		"ajv": {
			"optional": true
		}
	},
	"packageManager": "pnpm@11.7.0+sha512.19cc852c120c7125760f2443ee6be0ca5b40f9f50598de1a09a1f177503e010e57c23c77646e01e761de59bf874fb22a3398c33ab9691fc13eb946b6f0f4d620",
	"engines": {
		"node": ">=24.11.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.7.0+sha512.19cc852c120c7125760f2443ee6be0ca5b40f9f50598de1a09a1f177503e010e57c23c77646e01e761de59bf874fb22a3398c33ab9691fc13eb946b6f0f4d620",
			"onFail": "ignore"
		},
		"runtime": [
			{
				"name": "node",
				"version": "26.3.0",
				"onFail": "ignore"
			}
		]
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true,
			"github": "@spencerbeggs/xdg-effect"
		}
	}
}
